// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TRAINER
  ADMIN
  COUNSELOR
  PLACEMENT_OFFICER
  STAFF
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  CONVERTED
  LOST
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  phone        String?
  role         Role          @default(STUDENT)
  bio          String?
  avatar       String?       // initials or url
  permissions  String[]      @default([]) // for staff members: e.g. ["leads", "courses", "testimonials"]
  enrollments  Enrollment[]
  payments     Payment[]
  certificates Certificate[]
  reviews      Review[]
  blogs        Blog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

model Category {
  id      String   @id @default(uuid())
  name    String
  slug    String   @unique
  courses Course[]

  @@map("course_categories")
}

model Course {
  id                String       @id @default(uuid())
  name              String
  slug              String       @unique
  categoryId        String
  category          Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  duration          String
  level             String
  price             Float
  rating            Float        @default(5.0)
  reviewsCount      Int          @default(0)
  image             String
  brochure          String?      // public path to uploaded brochure
  description       String?      // course details description
  certificationBody String?      // e.g. "PMI", "Scrum Alliance"
  skillsCovered     String?      // JSON array string
  courseHighlights  String?      // JSON array string
  seoData           String?      // JSON object string
  syllabus          String       // JSON array of modules
  faqs              String       // JSON array of FAQs
  mentorName        String
  mentorExp         String
  mentorAvatar      String
  mentorBio         String
  batches           Batch[]
  enrollments       Enrollment[]
  payments          Payment[]
  certificates      Certificate[]
  reviews           Review[]
  assignments       Assignment[]
  createdAt         DateTime     @default(now())

  @@map("courses")
}

model Trainer {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  avatar    String?
  bio       String?
  specialty String?
  batches   Batch[]
  createdAt DateTime @default(now())

  @@map("trainers")
}

model Batch {
  id           String   @id @default(uuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainerId    String
  trainer      Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  startDate    String   // readable date string, e.g. "June 15, 2026"
  endDate      String?  // end date string
  timeZone     String   @default("IST")
  timeSlot     String   // e.g. "7:00 PM - 9:00 PM IST"
  seatsTotal   Int      @default(30)
  seatsLeft    Int      @default(30)
  linkZoom     String   @default("https://zoom.us/j/mock-meeting")
  batchType    String   @default("Weekend Batch") // "Weekend Batch", "Weekday Batch"
  trainingMode String   @default("Online Classroom") // "Online Classroom", "In-Person Classroom"
  status       String   @default("Upcoming") // "Upcoming", "Ongoing", "Completed"
  attendances  Attendance[]
  createdAt    DateTime @default(now())

  @@map("course_batches")
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress   Int      @default(0) // 0 to 100
  lastLesson String   @default("Introduction")
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Payment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  amount    Float
  status    String   @default("Success") // "Success", "Pending", "Failed"
  txId      String   @unique
  date      DateTime @default(now())

  @@map("payments")
}

model Lead {
  id        String     @id @default(uuid())
  name      String
  email     String
  phone     String
  course    String
  message   String?
  status    LeadStatus @default(NEW)
  notes     String?    @default("")
  createdAt DateTime   @default(now())

  @@map("enquiries")
}

model CorporateLead {
  id          String   @id @default(uuid())
  name        String
  company     String
  email       String
  phone       String
  size        String   // e.g. "10-50 employees"
  message     String?
  status      String   @default("New") // "New", "Contacted", "Proposal Sent", "Closed"
  createdAt   DateTime @default(now())

  @@map("corporate_leads")
}

model Webinar {
  id                 String   @id @default(uuid())
  title              String
  description        String
  speaker            String
  date               String   // e.g. "June 25, 2026"
  time               String   // e.g. "6:00 PM"
  link               String   @default("https://zoom.us/j/mock-webinar")
  registrationsCount Int      @default(0)
  status             String   @default("Upcoming") // "Upcoming", "Live", "Completed"
  createdAt          DateTime @default(now())

  @@map("webinars")
}

model Blog {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String   // Markdown or HTML
  category  String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  image     String
  tags      String[] @default([])
  views     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("blog_posts")
}

model Testimonial {
  id       String  @id @default(uuid())
  name     String
  role     String
  quote    String
  rating   Int     @default(5)
  featured Boolean @default(true)
  initial  String

  @@map("testimonials")
}

model Roadmap {
  id          String   @id @default(uuid())
  title       String
  description String
  steps       String   // JSON string of timeline nodes

  @@map("roadmaps")
}

model Certificate {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name           String   // recipient name
  courseName     String
  completionDate String
  certId         String   @unique // cryptographically unique hash or string
  createdAt      DateTime @default(now())

  @@map("certificates")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now())

  @@map("reviews")
}

model Assignment {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     String
  submissions String   @default("[]") // JSON representation of submissions array
  createdAt   DateTime @default(now())

  @@map("assignments")
}

model Attendance {
  id           String   @id @default(uuid())
  batchId      String
  batch        Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date         String
  presentCount Int      @default(0)
  absentCount  Int      @default(0)
  records      String   @default("[]") // JSON representation of records array
  createdAt    DateTime @default(now())

  @@map("attendances")
}

model NotificationSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("settings")
}

model NotificationLog {
  id        String   @id @default(uuid())
  type      String   // e.g. "ENROLLMENT_CONFIRMATION", "BATCH_REMINDER", "CERTIFICATE_ISSUED"
  recipient String   // e.g. "student@gmail.com" or "+91 9999999999"
  channel   String   // "EMAIL" or "WHATSAPP"
  content   String
  status    String   // "SENT", "DELIVERED", "FAILED"
  createdAt DateTime @default(now())

  @@map("notification_logs")
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("faqs")
}

model HomepageContent {
  id      String @id @default(uuid())
  section String // e.g. 'hero', 'why-us', 'stats', 'partner-logos'
  key     String // e.g. 'title', 'subtitle', 'stats-learners'
  value   String

  @@unique([section, key])
  @@map("homepage_content")
}

model ContactRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@map("contact_requests")
}

model OneOnOneRequest {
  id            String   @id @default(uuid())
  name          String
  email         String
  phone         String
  preferredTime String
  status        String   @default("Pending")
  createdAt     DateTime @default(now())

  @@map("one_on_one_requests")
}

model CertificationCategory {
  id           String                @id @default(uuid())
  name         String
  slug         String                @unique
  description  String?
  icon         String?
  displayOrder Int                   @default(0)
  isActive     Boolean               @default(true)
  courses      CertificationCourse[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@map("certification_categories")
}

model CertificationCourse {
  id                    String                @id @default(uuid())
  categoryId            String
  category              CertificationCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title                 String
  slug                  String                @unique
  shortDescription      String?
  duration              String
  level                 String
  certificationProvider String?
  image                 String
  displayOrder          Int                   @default(0)
  isFeatured            Boolean               @default(false)
  isPopular             Boolean               @default(false)
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@map("certification_courses")
}

